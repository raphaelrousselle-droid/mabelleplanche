# === Site ===
# URL publique du site (sans slash final). En local : http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# === Sanity (CMS) ===
# Laisser vide pour utiliser les données de démonstration (placeholders).
# Créer un projet : npx sanity@latest login  puis  npx sanity@latest init --env
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Token de lecture (Viewer) — utile pour les brouillons / la prévisualisation
SANITY_API_READ_TOKEN=
# Token d'écriture (Editor) — uniquement si vous activez le décrément de stock automatique
SANITY_API_WRITE_TOKEN=

# === Stripe ===
# Clé publique (Dashboard Stripe > Développeurs > Clés API). pk_test_... ou pk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Clé secrète — À FOURNIR (Dashboard Stripe > Développeurs > Clés API).
# Utiliser sk_test_... pour les tests, sk_live_... en production.
STRIPE_SECRET_KEY=
# Secret de signature du webhook (Dashboard Stripe > Webhooks, ou `stripe listen`)
STRIPE_WEBHOOK_SECRET=

# === Resend (emails transactionnels) ===
# À FOURNIR : compte Resend + domaine mabelleplanche.fr vérifié
RESEND_API_KEY=
# Adresse expéditrice (doit appartenir à un domaine vérifié dans Resend)
RESEND_FROM_EMAIL=commandes@mabelleplanche.fr
# Adresse qui reçoit les notifications de commande et les messages du formulaire contact
ORDER_NOTIFICATION_EMAIL=
